# data.go.kr 공공데이터포털 서비스키 (서버 전용).
# 반드시 **Encoding** 형태(%2F, %2B, %3D 가 이미 들어 있는 쪽)를 넣어라.
# 재인코딩하면 SERVICE_KEY_IS_NOT_REGISTERED_ERROR(code 30) 가 난다 — "미신청"과 구분이 안 된다.
#
# 필요한 활용신청(전 오퍼레이션):
#   15142580 행정안전부 한국지역정보개발원_(전국 통합데이터) 공공도서관 열람실 실시간 정보
#     - info_v2        도서관 통합정보(위치·운영시간·휴관)
#     - rlt_rdrm_info_v2  열람실 실시간 좌석
#   (prst_info_v2 는 현재 데이터가 비어 있어 사용하지 않는다.)
DATA_GO_KR_KEY=

# 크론(예열) 인증. Vercel Cron 이 Authorization: Bearer 로 붙여 준다.
# 없으면 /api/warm 이 503 으로 거부한다.
# 생성: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
CRON_SECRET=

# (선택·미래) 도서관 정보나루 자체 인증키. "이 책 어느 도서관에" 기능을 붙일 때 사용.
# data4library.kr 발급, 64자 순수 영숫자(%-인코딩 아님, verbatim). 현재 코드에서는 쓰지 않는다.
# DATA4LIBRARY_KEY=
